# A bare name ("venv") matches only at the top of the build context, so the
# folders that sit inside backend/ and frontend/ need **/ to be excluded:
# backend/venv is ~2 GB, and frontend/node_modules (Windows binaries) would
# overwrite the image's own `npm ci` install when COPY frontend/ runs.
**/venv
**/__pycache__
**/*.pyc
**/node_modules
**/dist
build
.git
.gitignore
.github
.vscode
.env
**/.env
api.txt
*.log
test_*.py
**/test_*.py
test_runner.py
backend/test_*.py
backend/test_hybrid_self_loop.py
backend/clear_cache.py
backend/llm_pure_classifier.py
backend/purge_embeddings_and_trees.py
backend/run_classifier.py
backend/test_and_verify.py
# NOTE: app/ingestion/llm_pure_classifier.py and llm_section_classifier.py were
# listed here. They are NOT optional: app/ingestion/parser.py imports both at
# module load, so excluding them made the image raise ModuleNotFoundError on
# startup and every Render deploy failed. Do not re-add them.
scratch/
backend/scratch/
chroma_db/
backend/chroma_db/
backend/uploads/*
backend/app/connection/*
backend/app/query/*

# Google credentials: never baked into an image (git ignores them too).
client_secret*.json
backend/client_secret*.json
token.json
backend/token.json
service_account*.json
backend/service_account*.json

# Local-only files the app never reads
*.bat
issued cases list
retrieval_test_queries*.pdf
backend/test_judgment.pdf
backend/ingest_reports/
# Evaluation tools and datasets: run from a checkout, not inside the server.
backend/eval/
